// ============================================================
// Use case ID:  OS-DET-AD-001_dcsync_non_dc
// Rule:         001_dcsync_non_dc.kql
// ATT&CK:       T1003.006 — OS Credential Dumping: DCSync
// Severity:     critical
// Author:       Detection KB
// Date:         2026-05-27
//
// Target:       Both (Sentinel and Defender XDR Advanced Hunting)
//   Sentinel    → TimeGenerated is available; XDR connector required for IdentityDirectoryEvents
//   DefenderXDR → swap TimeGenerated → Timestamp throughout
//
// Schedule:     every 5m
// Lookback:     1h
// Suppress:     AccountName:4h  (one alert per account per 4 hours)
//
// Prerequisite: Microsoft Defender for Identity sensor must be deployed on all
//               domain controllers. The Defender XDR data connector must be
//               enabled in Microsoft Sentinel.
//               Table: IdentityDirectoryEvents
//
// Description:
//   Detects non-domain-controller accounts performing Active Directory replication
//   via the MS-DRSR (DRSUAPI) protocol — the mechanism used by tools such as
//   Mimikatz (lsadump::dcsync), Impacket secretsdump, and CobaltStrike hashdump
//   to extract NTLM hashes and Kerberos keys without touching LSASS on the DC.
//
//   Legitimate replication is performed exclusively by domain controller machine
//   accounts (name ends with "$" and maps to a known DC). Any user account, or
//   a machine account not in the known DC list, triggering this action is
//   highly suspicious.
//
// False positives:
//   - Azure AD Connect / Entra Connect sync account (MSOL_*, AADConnect): performs
//     password hash sync via DRSUAPI — exclude by account name if sync is in use
//   - Quest Migration Manager, Semperis DSP, or other AD migration/backup tools
//     that use replication APIs — correlate with change-management tickets
//   - New domain controller promotion: the new DC account will appear briefly before
//     the DC inventory is updated — short-lived, resolvable via DeviceName cross-check
//   - Read-Only Domain Controllers (RODCs) replicating a subset of the directory —
//     should be in the DC inventory; exclude by AccountName ending in "$"
// ============================================================

// ── DC inventory: accounts that are allowed to perform replication ────────────
// Populate from your AD or pull dynamically from IdentityInfo.
// The filter uses two signals:
//   1. AccountName ends with "$"  — machine account convention for DCs
//   2. Joined with IdentityInfo to check the account is a known domain controller
let KnownDCAccounts = IdentityInfo
| where TimeGenerated > ago(7d)
| where AccountType == "Machine"
| where isnotempty(OnPremSid)
// Domain controllers have the UF_SERVER_TRUST_ACCOUNT flag; Defender for Identity
// surfaces this in the Tags field as "Domain controller"
| where Tags has "Domain controller"
| summarize by AccountName = tolower(AccountName), AccountDomain = tolower(AccountDomain);

// ── Known sync/backup exclusions ─────────────────────────────────────────────
// Add accounts here that legitimately use DRSUAPI (AAD Connect, migration tools).
// Keep this list short and audited — every entry is a detection blind spot.
let KnownSyncAccounts = datatable(AccountName: string, Reason: string)
[
    // "msol_abc123def456", "Azure AD Connect password hash sync",
    // "aadconnect_svc",    "Entra Connect service account",
];

// ── Core detection: DirectoryServicesReplication from non-DC account ─────────
IdentityDirectoryEvents
| where TimeGenerated > ago(1h)
| where ActionType == "DirectoryServicesReplication"
// --- normalise case for joins ---
| extend
    AccountNameNorm   = tolower(AccountName),
    AccountDomainNorm = tolower(AccountDomain)
// --- exclude legitimate DC-to-DC replication ---
| join kind=leftanti (
    KnownDCAccounts
    | project AccountName, AccountDomain
) on $left.AccountNameNorm == $right.AccountName,
  $left.AccountDomainNorm == $right.AccountDomain
// --- exclude known sync/backup accounts ---
| join kind=leftanti (
    KnownSyncAccounts | project AccountName
) on $left.AccountNameNorm == $right.AccountName
// ── Enrich with account context from IdentityInfo ─────────────────────────────
| join kind=leftouter (
    IdentityInfo
    | where TimeGenerated > ago(7d)
    | summarize arg_max(TimeGenerated, *) by AccountObjectId
    | project
        AccountObjectId,
        DisplayName         = AccountDisplayName,
        JobTitle,
        Department,
        IsAccountEnabled,
        IsMFARegistered,
        AssignedRoles,
        GroupMembership     = tostring(GroupMembership)
) on AccountObjectId
// ── Flag machine accounts performing DCSync (rare but possible in tool abuse) ──
| extend
    IsMachineAccount = AccountName endswith "$",
    // Extract the DC being targeted (the destination of the replication request)
    TargetDC = tostring(AdditionalFields.["DestinationDCName"])
// ── Severity graduation ───────────────────────────────────────────────────────
| extend
    // Critical: user account (not a machine) doing DCSync — always a human attacker or
    //           compromised credential; no legitimate scenario exists for this
    // High: machine account that is NOT a DC — could be a service account or
    //       renamed tool process abusing a machine credential
    Severity = case(
        not(IsMachineAccount),                         "Critical",
        IsMachineAccount and isnotempty(TargetDC),     "High",
        "High"
    )
// ── Rule metadata ─────────────────────────────────────────────────────────────
| extend
    ATT_CK  = "T1003.006",
    RuleID  = "OS-DET-AD-001_dcsync_non_dc",
    Triage  = strcat(
        "1. Confirm ", AccountName, " is NOT a domain controller or sync account. ",
        "2. Check DeviceName (", DeviceName, ") — is it a workstation, server, or DC? ",
        "3. Pull full process tree from DeviceProcessEvents for this host in the same window. ",
        "4. Isolate host immediately if a user account is the actor. ",
        "5. Reset the account credential and audit NTLM hash exposure across the domain."
    )
// ── Entity fields ─────────────────────────────────────────────────────────────
// Sentinel entity mapping: Account (AccountName + AccountDomain), Host (DeviceName)
// Defender XDR: AccountObjectId + DeviceName satisfy the required schema columns
| extend
    AccountNameOut   = AccountName,
    AccountDomainOut = AccountDomain
// ── Output ────────────────────────────────────────────────────────────────────
| project-reorder
    Severity,
    AccountNameOut,
    AccountDomainOut,
    DisplayName,
    JobTitle,
    Department,
    IsAccountEnabled,
    IsMFARegistered,
    IsMachineAccount,
    DeviceName,
    IPAddress,
    TargetDC,
    TimeGenerated,
    ActionType,
    AssignedRoles,
    GroupMembership,
    AdditionalFields,
    ATT_CK,
    RuleID,
    Triage
| sort by TimeGenerated asc

// ============================================================
// TEST CASES
//
// Positive — should fire (Critical):
//   AccountName:   john.doe           (no trailing "$" — user account)
//   AccountDomain: contoso.com
//   ActionType:    DirectoryServicesReplication
//   DeviceName:    WORKSTATION01
//   Expected:      Severity = Critical
//
// Positive — should fire (High):
//   AccountName:   SVC_BACKUP$        (machine account but not in DC inventory)
//   AccountDomain: contoso.com
//   ActionType:    DirectoryServicesReplication
//   DeviceName:    BACKUPSRV01
//   Expected:      Severity = High
//
// Negative — should NOT fire (legitimate DC replication):
//   AccountName:   DC01$              (in KnownDCAccounts, tagged "Domain controller")
//   AccountDomain: contoso.com
//   ActionType:    DirectoryServicesReplication
//   Expected:      filtered by leftanti join on KnownDCAccounts
//
// Negative — should NOT fire (Azure AD Connect):
//   AccountName:   msol_abc123def456  (in KnownSyncAccounts)
//   ActionType:    DirectoryServicesReplication
//   Expected:      filtered by leftanti join on KnownSyncAccounts
// ============================================================
