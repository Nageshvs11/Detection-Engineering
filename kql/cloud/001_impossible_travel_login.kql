// ============================================================
// Use case ID:  Cloud-DET-Azure-001_impossible_travel_login
// Rule:         001_impossible_travel_login.kql
// ATT&CK:       T1078.004 — Valid Accounts: Cloud Accounts
// Severity:     high
// Author:       Detection KB
// Date:         2026-05-27
// Prerequisite: Azure AD / Entra ID data connector must be enabled
//               (SignInLogs table must be present in the workspace)
//
// Description:
//   Detects a single user account successfully signing in from two different
//   countries within a configurable time window, indicating either a
//   compromised account (attacker replaying stolen credentials from a
//   different geography) or account sharing across regions.
//
// False positives:
//   - Users connected to a VPN that exits in a different country from their
//     physical location — correlate with known VPN egress IP ranges
//   - Corporate proxy or ZTNA solutions that route traffic through a fixed
//     international egress point — baseline known proxy IPs and exclude
//   - Users traveling internationally who sign in mid-flight via satellite
//     Wi-Fi and then land — review TimeDelta_min; <30 min is higher fidelity
//   - Shared/break-glass accounts accessed from multiple geographic regions
//     by different administrators — exclude by UPN or mark as expected
//   - Mobile hotspot with carrier roaming showing incorrect geolocation
// ============================================================

let TravelWindow    = 1h;    // sign-ins this close together from different countries = alert
let LookbackPeriod  = 1d;    // how far back to search for sign-in pairs

// ── Base dataset: successful Azure AD sign-ins with valid location data ───────
let SignIns = SignInLogs
| where TimeGenerated > ago(LookbackPeriod)
| where ResultType == 0                                    // successful sign-ins only
| where isnotempty(LocationDetails)
| extend
    Country  = tostring(LocationDetails.countryOrRegion),
    City     = tostring(LocationDetails.city),
    Lat      = toreal(LocationDetails.geoCoordinates.latitude),
    Lon      = toreal(LocationDetails.geoCoordinates.longitude)
| where isnotempty(Country) and Country != "Unknown"
// --- noise reduction: exclude known automation and non-interactive sign-in types ---
| where UserType != "Guest"                                // guests often connect globally by design
| where ClientAppUsed !in ("ROPC", "Legacy Authentication protocols") // exclude legacy noise
| project
    TimeGenerated,
    UserPrincipalName,
    UserDisplayName,
    IPAddress,
    Country,
    City,
    Lat,
    Lon,
    AppDisplayName,
    ClientAppUsed,
    AuthenticationRequirement,
    ConditionalAccessStatus,
    RiskLevelDuringSignIn,
    RiskLevelAggregated,
    CorrelationId;

// ── Self-join: find pairs of sign-ins from different countries within window ──
SignIns
| join kind=inner (
    SignIns
    | project
        TimeGenerated2            = TimeGenerated,
        UserPrincipalName,
        IPAddress2                = IPAddress,
        Country2                  = Country,
        City2                     = City,
        Lat2                      = Lat,
        Lon2                      = Lon,
        AppDisplayName2           = AppDisplayName,
        ClientAppUsed2            = ClientAppUsed,
        CorrelationId2            = CorrelationId
) on UserPrincipalName
// --- core behavior: different countries, ordered pair, within travel window ---
| where Country != Country2                                // must be different countries
| where TimeGenerated < TimeGenerated2                     // enforce ordering (prevents duplicate pairs)
| where (TimeGenerated2 - TimeGenerated) <= TravelWindow   // within the impossible-travel window
// --- enrich ---
| extend
    TimeDelta_min = datetime_diff("minute", TimeGenerated2, TimeGenerated),
    TravelRoute   = strcat(Country, " (", City, ")  →  ", Country2, " (", City2, ")")
// ── Summarise to one row per user, surfacing the most suspicious (shortest) pair ─
| summarize
    FirstSignIn       = min(TimeGenerated),
    SecondSignIn      = min(TimeGenerated2),
    TimeDelta_min     = min(TimeDelta_min),
    TravelRoute       = take_any(TravelRoute),
    FirstCountry      = take_any(Country),
    SecondCountry     = take_any(Country2),
    FirstIP           = take_any(IPAddress),
    SecondIP          = take_any(IPAddress2),
    FirstApp          = take_any(AppDisplayName),
    SecondApp         = take_any(AppDisplayName2),
    FirstClient       = take_any(ClientAppUsed),
    SecondClient      = take_any(ClientAppUsed2),
    RiskLevel         = take_any(RiskLevelDuringSignIn),
    RiskAggregate     = take_any(RiskLevelAggregated),
    ConditionalAccess = take_any(ConditionalAccessStatus)
    by UserPrincipalName, UserDisplayName
// ── Severity graduation: faster travel = more suspicious ─────────────────────
| extend
    // high: any two-country sign-in within the window is suspicious by default;
    // critical if it happened in under 10 minutes (physically impossible for any
    // real travel) and identity protection risk is non-none
    Severity = case(
        TimeDelta_min <= 10 and RiskLevel != "none", "Critical",
        TimeDelta_min <= 10,                          "High",
        "High"
    ),
    ATT_CK    = "T1078.004",
    RuleID    = "Cloud-DET-Azure-001_impossible_travel_login",
    Triage    = strcat(
        "Verify with user whether travel to ", SecondCountry, " is expected. ",
        "Check if ", FirstIP, " or ", SecondIP, " match known VPN/proxy egress IPs. ",
        "Review Conditional Access status and identity risk score before escalating."
    )
| project-reorder
    Severity,
    UserPrincipalName,
    UserDisplayName,
    TravelRoute,
    TimeDelta_min,
    FirstSignIn,
    SecondSignIn,
    FirstIP,
    SecondIP,
    FirstApp,
    SecondApp,
    FirstClient,
    SecondClient,
    RiskLevel,
    RiskAggregate,
    ConditionalAccess,
    ATT_CK,
    RuleID,
    Triage

// ============================================================
// TEST CASES
//
// Positive — should fire:
//   UserPrincipalName: john.doe@contoso.com
//   Sign-in 1: 2026-05-27T08:00:00Z | Country: UAE  | IP: 185.x.x.x | ResultType: 0
//   Sign-in 2: 2026-05-27T08:45:00Z | Country: USA  | IP: 104.x.x.x | ResultType: 0
//   TimeDelta: 45 min — physically impossible → Severity: High
//
// Positive (critical path) — should fire as Critical:
//   Sign-in 1: 2026-05-27T09:00:00Z | Country: UAE  | ResultType: 0
//   Sign-in 2: 2026-05-27T09:07:00Z | Country: Russia | ResultType: 0
//   TimeDelta: 7 min + elevated risk score → Severity: Critical
//
// Negative — should NOT fire:
//   Sign-in 1: 2026-05-27T08:00:00Z | Country: UAE  | ResultType: 0
//   Sign-in 2: 2026-05-27T10:30:00Z | Country: India | ResultType: 0
//   TimeDelta: 150 min → outside TravelWindow (1h), no alert
//
// Negative — should NOT fire:
//   Sign-in 1: 2026-05-27T08:00:00Z | Country: UAE | ResultType: 0
//   Sign-in 2: 2026-05-27T08:30:00Z | Country: UAE | ResultType: 0
//   Same country → no alert
// ============================================================
